# AudioSync AI - Speech-to-Text Environment Variables (Optional)
# If left blank, the app uses the built-in local Faster-Whisper (CTranslate2) engine automatically!

# Groq Cloud Whisper API (whisper-large-v3, lightning-fast transcription with word timestamps)
GROQ_API_KEY=

# OpenAI Cloud Whisper API (whisper-1, word-level timestamps)
OPENAI_API_KEY=

# Default local whisper model (tiny, base, small, medium)
DEFAULT_WHISPER_MODEL=base

